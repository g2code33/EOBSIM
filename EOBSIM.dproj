        <VerInfo_Keys>CompanyName=;FileDescription=EOSIM - Electronic Organ Bath Simulation;FileVersion=1.0.0.0;InternalName=EOBSIM;LegalCopyright=;LegalTrademarks=;OriginalFilename=EOBSIM.exe;ProductName=EOSIM;ProductVersion=1.0.0.0;Comments=Electronic Organ Bath Simulation</VerInfo_Keys>
        <DCC_Namespace>Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;System;Xml;Data;Datasnap;Web;Soap;Winapi;$(DCC_Namespace)</DCC_Namespace>
        <VerInfo_MinorVer>0</VerInfo_MinorVer>
